# _td_core - shared utilities loaded by entry point
# This file body becomes the function body via autoload

# Error output helper
_td_error() {
  printf "todo: %s\n" "$1" >&2
}

# Success output helper
_td_success() {
  printf "%s\n" "$1"
}

# Version helper
_td_version_string() {
  printf "todo v%s\n" "$TD_VERSION"
}

# JXA helper, prepended to any transform that needs the "completed" status.
# Kept as one shared snippet so the definition of "done" cannot drift between
# done / bulk done / archive / the interactive UI.
typeset -g TD_JS_DONE_STATUS='
  function _tdDoneStatus(data) {
    var s = data.statuses || [];
    if (!s.length) return "";
    for (var i = 0; i < s.length; i++) {
      if (String(s[i]).toLowerCase() === "done") return s[i];
    }
    return s[s.length - 1];
  }
'

# Resolve which status means "completed" for a list.
# Prefers a status literally named "done" (case-insensitive); only falls back to
# the last status when there is none. Taking the last status unconditionally is
# wrong the moment a user follows the README and runs `todo status add
# in-review`: "done" then silently means "in-review".
# Usage: _td_resolve_done_status <tasks_file>
_td_resolve_done_status() {
  local tasks_file="$1"

  JSON_DATA="$(cat "$tasks_file")" osascript -l JavaScript -e '
    function run() {
      var data = JSON.parse(
        $.NSProcessInfo.processInfo.environment.objectForKey("JSON_DATA").js
      );
      var s = data.statuses || [];
      if (!s.length) return "";
      for (var i = 0; i < s.length; i++) {
        if (String(s[i]).toLowerCase() === "done") return s[i];
      }
      return s[s.length - 1];
    }
  ' 2>/dev/null
}

# Resolve task ID from prefix (case-insensitive)
# Usage: _td_resolve_task_id <tasks_file> <id_prefix>
# Returns: full UUID to stdout, or error + return 1
_td_resolve_task_id() {
  local tasks_file="$1"
  local prefix="${2:u}"  # uppercase for UUID matching

  [[ -f "$tasks_file" ]] || { _td_error "File not found: $tasks_file"; return 1; }

  local result
  result=$(TASK_PREFIX="$prefix" JSON_DATA="$(cat "$tasks_file")" osascript -l JavaScript -e '
    function run() {
      var env = $.NSProcessInfo.processInfo.environment;
      var data = JSON.parse(env.objectForKey("JSON_DATA").js);
      var prefix = env.objectForKey("TASK_PREFIX").js;
      var matches = data.tasks.filter(function(t) {
        return t.id.toUpperCase().indexOf(prefix) === 0;
      });
      if (matches.length === 0) return "ERROR:not_found";
      if (matches.length > 1) return "ERROR:ambiguous:" + matches.length;
      return matches[0].id;
    }
  ' 2>/dev/null) || { _td_error "ID resolution failed"; return 1; }

  case "$result" in
    ERROR:not_found)
      _td_error "No task matching '$prefix'"
      return 1 ;;
    ERROR:ambiguous:*)
      _td_error "Ambiguous ID '$prefix' matches ${result##*:} tasks. Be more specific."
      return 1 ;;
    *)
      printf '%s\n' "$result" ;;
  esac
}
