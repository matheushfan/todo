# _td_layout - geometry for every view
# Autoloaded: file body = function body
#
# Pure integer arithmetic: no I/O, no forks, no terminal. That is deliberate --
# it makes every breakpoint unit-testable without a tty, and it keeps the one
# place that decides "does this fit" out of the renderers.

typeset -g  TD_L_W=80 TD_L_H=25
typeset -g  TD_L_MODE=board        # board | list | refuse
typeset -ga TD_L_COLW=()
typeset -g  TD_L_ROWS=19           # task rows available
typeset -g  TD_L_CHROME=6
typeset -g  TD_L_PEEK=1            # peek lines: 0, 1 or 3
typeset -g  TD_L_CONTEXT=1         # is the context bar drawn
typeset -g  TD_L_CLOSE=1           # is the closing rule drawn
typeset -g  TD_L_ERR=''

: ${TD_L_MIN_COL:=20}              # a column narrower than this is unreadable
: ${TD_L_MIN_W:=20}
: ${TD_L_MIN_H:=8}

# _td_layout_compute <width> <height> <num_statuses> [interactive]
# Sets the TD_L_* globals. Returns 1 when the terminal is too small.
_td_layout_compute() {
  local w="$1" h="$2" k="$3" interactive="${4:-1}"
  TD_L_ERR=''
  TD_L_W=$w; TD_L_H=$h

  if (( k < 1 )); then
    TD_L_MODE=refuse
    TD_L_ERR="no statuses defined"
    return 1
  fi

  # --- floor ---
  # Only the TUI refuses; the static board has list mode, which has no minimum.
  if (( interactive )) && (( w < TD_L_MIN_W || h < TD_L_MIN_H )); then
    TD_L_MODE=refuse
    TD_L_ERR="terminal too small (need ${TD_L_MIN_W}x${TD_L_MIN_H}, have ${w}x${h})"
    return 1
  fi

  # --- columns ---
  # One separator between each pair, so K columns cost K-1 separators. The
  # remainder is handed out one column at a time to the leftmost columns, so
  # the board always fills the width exactly rather than leaving a ragged edge.
  local usable=$(( w - (k - 1) ))
  local base=$(( usable / k ))
  local extra=$(( usable % k ))

  TD_L_COLW=()
  if (( base < TD_L_MIN_COL )); then
    TD_L_MODE=list
  else
    TD_L_MODE=board
    local i
    for (( i = 1; i <= k; i++ )); do
      TD_L_COLW+=( $(( base + (i <= extra ? 1 : 0) )) )
    done
  fi

  # --- rows ---
  if (( ! interactive )); then
    # Static: context, headers, opening rule, closing rule. Cards are two
    # lines each, so the row budget is halved.
    TD_L_CHROME=4
    TD_L_PEEK=0
    TD_L_CONTEXT=1
    TD_L_CLOSE=1
    TD_L_ROWS=$(( (h - 6) / 2 ))
    (( TD_L_ROWS < 3 )) && TD_L_ROWS=3
    return 0
  fi

  # Interactive: shed chrome in a fixed order as height shrinks. The command
  # line and the priority glyph are never shed at any size.
  TD_L_CONTEXT=1; TD_L_CLOSE=1
  if   (( h >= 30 && w >= 96 )); then TD_L_PEEK=3; TD_L_CHROME=8
  elif (( h >= 24 ));           then TD_L_PEEK=1; TD_L_CHROME=6
  elif (( h >= 16 ));           then TD_L_PEEK=0; TD_L_CHROME=5
  elif (( h >= 10 ));           then TD_L_PEEK=0; TD_L_CHROME=4; TD_L_CONTEXT=0
  else                               TD_L_PEEK=0; TD_L_CHROME=3; TD_L_CONTEXT=0; TD_L_CLOSE=0
  fi

  TD_L_ROWS=$(( h - TD_L_CHROME ))
  (( TD_L_ROWS < 1 )) && TD_L_ROWS=1
  return 0
}

# Text width available inside a cell.
#   interactive: [gutter 1][sp 1][priority 1][sp 1][text][pad 1]  -> cw - 5
#   static:      [sp 1][priority 1][sp 1][text][pad 1]            -> cw - 4
# The trailing pad column is mandatory: cell text never touches the rule.
_td_layout_textw() {
  local cw="$1" interactive="${2:-1}"
  local reserved=$(( interactive ? 5 : 4 ))
  REPLY=$(( cw - reserved ))
  (( REPLY < 1 )) && REPLY=1
}

# Clamp a column's scroll window around the cursor, keeping `scrolloff` rows of
# context above and below where the data allows.
# _td_layout_scroll <cursor> <count> <visible> [scrolloff] -> REPLY = top index
_td_layout_scroll() {
  local cur="$1" count="$2" vis="$3" off="${4:-2}"
  if (( count <= vis )); then REPLY=1; return; fi

  # A large scrolloff on a short window would fight itself.
  (( off > (vis - 1) / 2 )) && off=$(( (vis - 1) / 2 ))

  local top=$(( cur - off ))
  (( top < 1 )) && top=1
  (( top + vis - 1 > count )) && top=$(( count - vis + 1 ))
  (( top < 1 )) && top=1
  REPLY=$top
}
