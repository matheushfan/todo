# _td_interactive - zcurses interactive kanban board engine
# Autoloaded: file body = function body

# Global state for interactive mode
typeset -ga _TD_UI_STATUSES=()
typeset -gA _TD_UI_COL_TASKS=()
typeset -ga _TD_UI_COL_COUNTS=()
typeset -g _TD_UI_TOTAL_TASKS=0
typeset -ga _TD_UI_WINDOWS=()

# Navigation state
typeset -g _TD_UI_SEL_COL=1
typeset -g _TD_UI_SEL_ROW=1

# Tasks file path (global for action functions)
typeset -g _TD_UI_TASKS_FILE=""

# Resize state
typeset -g _TD_UI_NEED_REDRAW=0

# List name (global for resize handler access)
typeset -g _TD_UI_LIST_NAME=""

# Help overlay state
typeset -g _TD_UI_HELP_VISIBLE=0

# Load task data via single JXA call into zsh arrays
# Usage: _td_interactive_load_data <tasks_file>
_td_interactive_load_data() {
  local tasks_file="$1"

  [[ -f "$tasks_file" ]] || { _td_error "File not found: $tasks_file"; return 1; }

  # Single JXA call: returns statuses on first line, then __COL_SEP__-separated task blocks
  # Format: STATUS1\nSTATUS2\n...\n__HDR_SEP__\ntask_lines\n__COL_SEP__\ntask_lines...
  local raw_output
  raw_output=$(JSON_DATA="$(cat "$tasks_file")" osascript -l JavaScript -e '
    function run() {
      var env = $.NSProcessInfo.processInfo.environment;
      var data = JSON.parse(env.objectForKey("JSON_DATA").js);
      var header = data.statuses.join("\n");
      var blocks = data.statuses.map(function(status) {
        var tasks = data.tasks.filter(function(t) { return t.status === status; });
        if (tasks.length === 0) return "";
        var lines = tasks.map(function(t) {
          var tagStr = t.tags && t.tags.length > 0 ? t.tags.join(",") : "";
          return t.id + "\t" + t.priority + "\t" + tagStr + "\t" + t.text + "\t" + (t.ref || "");
        });
        return lines.join("\n");
      });
      return header + "\n__HDR_SEP__\n" + blocks.join("\n__COL_SEP__\n");
    }
  ' 2>/dev/null) || { _td_error "Failed to load task data"; return 1; }

  # Split header from body
  local header_part="${raw_output%%__HDR_SEP__*}"
  local body_part="${raw_output#*__HDR_SEP__}"
  # Trim leading newline from body
  body_part="${body_part#$'\n'}"

  # Parse statuses
  header_part="${header_part%$'\n'}"
  _TD_UI_STATUSES=("${(@f)header_part}")

  # Parse task blocks
  local -a blocks
  blocks=("${(@s:__COL_SEP__:)body_part}")

  _TD_UI_COL_TASKS=()
  _TD_UI_COL_COUNTS=()
  _TD_UI_TOTAL_TASKS=0

  local raw_block row_idx line
  local -a lines
  local c

  for (( c=1; c<=${#_TD_UI_STATUSES[@]}; c++ )); do
    raw_block="${blocks[$c]}"
    raw_block="${raw_block#$'\n'}"
    raw_block="${raw_block%$'\n'}"

    if [[ -z "$raw_block" ]]; then
      _TD_UI_COL_COUNTS[$c]=0
    else
      lines=("${(@f)raw_block}")
      _TD_UI_COL_COUNTS[$c]=${#lines[@]}
      (( _TD_UI_TOTAL_TASKS += ${#lines[@]} ))

      row_idx=1
      for line in "${lines[@]}"; do
        _TD_UI_COL_TASKS[$c,$row_idx]="$line"
        (( row_idx++ ))
      done
    fi
  done
}

# Create zcurses windows for layout
_td_interactive_create_windows() {
  local num_cols=${#_TD_UI_STATUSES[@]}
  local col_width col_height col_y col_x

  _TD_UI_WINDOWS=()

  # Header window: row 0, full width, height 1
  zcurses addwin header 1 $COLUMNS 0 0
  _TD_UI_WINDOWS+=(header)

  # Column windows
  col_height=$(( LINES - 2 ))  # header + statusbar
  col_width=$(( (COLUMNS - 2) / num_cols ))

  # Enforce minimum column width
  if (( col_width < 15 )); then
    col_width=15
  fi

  local i
  for (( i=1; i<=num_cols; i++ )); do
    col_y=1
    col_x=$(( (i - 1) * col_width ))
    zcurses addwin "col${i}" $col_height $col_width $col_y $col_x
    _TD_UI_WINDOWS+=("col${i}")
  done

  # Status bar window: last row, full width, height 1
  zcurses addwin statusbar 1 $COLUMNS $(( LINES - 1 )) 0
  _TD_UI_WINDOWS+=(statusbar)
}

# Cleanup all zcurses windows
_td_interactive_cleanup_windows() {
  local delwin
  for delwin in ${_TD_UI_WINDOWS:*zcurses_windows}; do
    zcurses delwin "$delwin"
  done
}

# Initialize selection to first non-empty column
_td_interactive_init_selection() {
  _TD_UI_SEL_COL=1
  _TD_UI_SEL_ROW=1

  # If column 1 is empty, find first non-empty column
  if (( ${_TD_UI_COL_COUNTS[1]:-0} == 0 )); then
    _td_interactive_nav_right
  fi
}

# Navigate down within a column (wraps at bottom)
_td_interactive_nav_down() {
  local count=${_TD_UI_COL_COUNTS[$_TD_UI_SEL_COL]:-0}
  (( count == 0 )) && return

  (( _TD_UI_SEL_ROW++ ))
  if (( _TD_UI_SEL_ROW > count )); then
    _TD_UI_SEL_ROW=1
  fi
}

# Navigate up within a column (wraps at top)
_td_interactive_nav_up() {
  local count=${_TD_UI_COL_COUNTS[$_TD_UI_SEL_COL]:-0}
  (( count == 0 )) && return

  (( _TD_UI_SEL_ROW-- ))
  if (( _TD_UI_SEL_ROW < 1 )); then
    _TD_UI_SEL_ROW=$count
  fi
}

# Navigate right to next column with tasks (skips empty, wraps)
_td_interactive_nav_right() {
  local total=${#_TD_UI_STATUSES[@]}
  local start=$_TD_UI_SEL_COL
  local c

  for (( c=1; c<total; c++ )); do
    local check=$(( (start - 1 + c) % total + 1 ))
    if (( ${_TD_UI_COL_COUNTS[$check]:-0} > 0 )); then
      _TD_UI_SEL_COL=$check
      # Clamp row to new column's task count
      local new_count=${_TD_UI_COL_COUNTS[$check]}
      if (( _TD_UI_SEL_ROW > new_count )); then
        _TD_UI_SEL_ROW=$new_count
      fi
      return
    fi
  done
  # No column with tasks found; stay put
}

# Navigate left to previous column with tasks (skips empty, wraps)
_td_interactive_nav_left() {
  local total=${#_TD_UI_STATUSES[@]}
  local start=$_TD_UI_SEL_COL
  local c

  for (( c=1; c<total; c++ )); do
    local check=$(( (start - 1 - c + total) % total + 1 ))
    if (( ${_TD_UI_COL_COUNTS[$check]:-0} > 0 )); then
      _TD_UI_SEL_COL=$check
      # Clamp row to new column's task count
      local new_count=${_TD_UI_COL_COUNTS[$check]}
      if (( _TD_UI_SEL_ROW > new_count )); then
        _TD_UI_SEL_ROW=$new_count
      fi
      return
    fi
  done
  # No column with tasks found; stay put
}

# Get selected task's UUID (first tab-separated field)
_td_interactive_get_selected_id() {
  local task_line="${_TD_UI_COL_TASKS[$_TD_UI_SEL_COL,$_TD_UI_SEL_ROW]}"
  [[ -z "$task_line" ]] && return 1
  printf '%s' "${task_line%%	*}"
}

# Get selected task's ref URL (5th tab-separated field)
_td_interactive_get_selected_ref() {
  local task_line="${_TD_UI_COL_TASKS[$_TD_UI_SEL_COL,$_TD_UI_SEL_ROW]}"
  [[ -z "$task_line" ]] && return 1
  local rest="${task_line#*	}"   # skip id
  rest="${rest#*	}"               # skip priority
  rest="${rest#*	}"               # skip tags
  rest="${rest#*	}"               # skip text
  printf '%s' "$rest"              # ref URL
}

# Show a brief message in the status bar
_td_interactive_status_msg() {
  local msg="$1"
  zcurses clear statusbar
  zcurses attr statusbar reverse
  local padded="${msg}${(l:$((COLUMNS - ${#msg})):: :)}"
  zcurses move statusbar 0 0
  zcurses string statusbar "$padded"
  zcurses attr statusbar -reverse
  zcurses refresh statusbar
}

# Adjust selection after data mutation (clamp row, find non-empty column)
_td_interactive_adjust_selection() {
  local count=${_TD_UI_COL_COUNTS[$_TD_UI_SEL_COL]:-0}
  if (( count == 0 )); then
    _TD_UI_SEL_ROW=1
    _td_interactive_nav_right
  elif (( _TD_UI_SEL_ROW > count )); then
    _TD_UI_SEL_ROW=$count
  fi
}

# Handle terminal resize: destroy windows, recreate, re-render
_td_interactive_handle_resize() {
  _TD_UI_HELP_VISIBLE=0
  _td_interactive_cleanup_windows
  zcurses clear stdscr redraw
  zcurses refresh stdscr
  _td_interactive_create_windows
  _td_interactive_render "$_TD_UI_LIST_NAME"
  _td_interactive_adjust_selection
  _TD_UI_NEED_REDRAW=0
}

# Show help overlay window with all keybindings
_td_interactive_show_help() {
  local help_w=$(( COLUMNS - 4 ))
  (( help_w > 50 )) && help_w=50
  local help_h=$(( LINES - 4 ))
  (( help_h > 18 )) && help_h=18

  local help_y=$(( (LINES - help_h) / 2 ))
  local help_x=$(( (COLUMNS - help_w) / 2 ))

  zcurses addwin helpwin $help_h $help_w $help_y $help_x
  _TD_UI_WINDOWS+=(helpwin)

  zcurses clear helpwin
  zcurses border helpwin

  # Title centered on row 1
  local title="Help"
  local title_x=$(( (help_w - ${#title}) / 2 ))
  zcurses attr helpwin +bold
  zcurses move helpwin 1 $title_x
  zcurses string helpwin "$title"
  zcurses attr helpwin -bold

  # Keybinding content starting at row 3
  local row=3 inner_w=$(( help_w - 4 ))

  # Navigation section
  zcurses attr helpwin +bold
  zcurses move helpwin $row 2
  zcurses string helpwin "Navigation"
  zcurses attr helpwin -bold
  (( row++ ))

  zcurses move helpwin $row 4; zcurses string helpwin "j / Down     Move down"
  (( row++ ))
  zcurses move helpwin $row 4; zcurses string helpwin "k / Up       Move up"
  (( row++ ))
  zcurses move helpwin $row 4; zcurses string helpwin "h / Left     Previous column"
  (( row++ ))
  zcurses move helpwin $row 4; zcurses string helpwin "l / Right    Next column"
  (( row++ ))
  (( row++ ))

  # Actions section
  zcurses attr helpwin +bold
  zcurses move helpwin $row 2
  zcurses string helpwin "Actions"
  zcurses attr helpwin -bold
  (( row++ ))

  zcurses move helpwin $row 4; zcurses string helpwin "s            Cycle status"
  (( row++ ))
  zcurses move helpwin $row 4; zcurses string helpwin "d            Mark done"
  (( row++ ))
  zcurses move helpwin $row 4; zcurses string helpwin "x            Delete task"
  (( row++ ))
  zcurses move helpwin $row 4; zcurses string helpwin "o            Open ref URL"
  (( row++ ))

  # General section (only if space)
  if (( row + 3 < help_h - 1 )); then
    (( row++ ))
    zcurses attr helpwin +bold
    zcurses move helpwin $row 2
    zcurses string helpwin "General"
    zcurses attr helpwin -bold
    (( row++ ))

    zcurses move helpwin $row 4; zcurses string helpwin "?            Toggle this help"
    (( row++ ))
    zcurses move helpwin $row 4; zcurses string helpwin "q            Quit"
  fi

  # "Press any key to close" at bottom
  local close_msg="Press any key to close"
  local close_x=$(( (help_w - ${#close_msg}) / 2 ))
  zcurses attr helpwin dim
  zcurses move helpwin $(( help_h - 2 )) $close_x
  zcurses string helpwin "$close_msg"
  zcurses attr helpwin -dim

  zcurses refresh helpwin
  _TD_UI_HELP_VISIBLE=1
}

# Hide help overlay and re-render board
_td_interactive_hide_help() {
  if [[ -n "${_TD_UI_WINDOWS[(r)helpwin]}" ]]; then
    zcurses delwin helpwin
    _TD_UI_WINDOWS=(${_TD_UI_WINDOWS:#helpwin})
  fi
  _TD_UI_HELP_VISIBLE=0
  _td_interactive_render "$_TD_UI_LIST_NAME"
}

# Action: cycle selected task to next status column
_td_interactive_action_status() {
  local task_id
  task_id="$(_td_interactive_get_selected_id)" || {
    _td_interactive_status_msg " No task selected "
    return
  }

  local next_col=$(( _TD_UI_SEL_COL % ${#_TD_UI_STATUSES[@]} + 1 ))
  local new_status="${_TD_UI_STATUSES[$next_col]}"

  export TASK_ID="$task_id" NEW_STATUS="$new_status"
  _td_storage_modify "$_TD_UI_TASKS_FILE" '
    var env = $.NSProcessInfo.processInfo.environment;
    var tid = env.objectForKey("TASK_ID").js;
    var ns = env.objectForKey("NEW_STATUS").js;
    var idx = data.tasks.findIndex(function(t) { return t.id === tid; });
    if (idx >= 0) { data.tasks[idx].status = ns; data.tasks[idx].updated = new Date().toISOString(); }
  '
  unset TASK_ID NEW_STATUS

  _td_interactive_load_data "$_TD_UI_TASKS_FILE"

  # Follow the task to its new column
  _TD_UI_SEL_COL=$next_col
  # Find the task in the new column
  local r found=0
  for (( r=1; r<=${_TD_UI_COL_COUNTS[$next_col]:-0}; r++ )); do
    local line="${_TD_UI_COL_TASKS[$next_col,$r]}"
    if [[ "${line%%	*}" == "$task_id" ]]; then
      _TD_UI_SEL_ROW=$r
      found=1
      break
    fi
  done
  if (( ! found )); then
    _td_interactive_adjust_selection
  fi

  _td_interactive_status_msg " Moved to ${new_status} "
}

# Action: mark selected task as done (last status)
_td_interactive_action_done() {
  local task_id
  task_id="$(_td_interactive_get_selected_id)" || {
    _td_interactive_status_msg " No task selected "
    return
  }

  export TASK_ID="$task_id"
  _td_storage_modify "$_TD_UI_TASKS_FILE" '
    var env = $.NSProcessInfo.processInfo.environment;
    var tid = env.objectForKey("TASK_ID").js;
    var idx = data.tasks.findIndex(function(t) { return t.id === tid; });
    if (idx >= 0) { data.tasks[idx].status = data.statuses[data.statuses.length - 1]; data.tasks[idx].updated = new Date().toISOString(); }
  '
  unset TASK_ID

  _td_interactive_load_data "$_TD_UI_TASKS_FILE"
  _td_interactive_adjust_selection

  _td_interactive_status_msg " Marked done "
}

# Action: delete selected task (no confirmation)
_td_interactive_action_delete() {
  local task_id
  task_id="$(_td_interactive_get_selected_id)" || {
    _td_interactive_status_msg " No task selected "
    return
  }

  export TASK_ID="$task_id"
  _td_storage_modify "$_TD_UI_TASKS_FILE" '
    var tid = $.NSProcessInfo.processInfo.environment.objectForKey("TASK_ID").js;
    data.tasks = data.tasks.filter(function(t) { return t.id !== tid; });
  '
  unset TASK_ID

  _td_interactive_load_data "$_TD_UI_TASKS_FILE"
  _td_interactive_adjust_selection

  _td_interactive_status_msg " Task deleted "
}

# Action: open selected task's ref URL in browser
_td_interactive_action_open() {
  local ref_url
  ref_url="$(_td_interactive_get_selected_ref)"

  if [[ -z "$ref_url" ]]; then
    _td_interactive_status_msg " No ref URL "
    return
  fi

  open "$ref_url"
  _td_interactive_status_msg " Opened ${ref_url} "
}

# Render the kanban board in zcurses windows
# Usage: _td_interactive_render <list_name>
_td_interactive_render() {
  local list_name="$1"
  local num_cols=${#_TD_UI_STATUSES[@]}

  # Check if terminal is too narrow for columns
  local col_width=$(( (COLUMNS - 2) / num_cols ))
  if (( col_width < 15 )); then
    zcurses clear stdscr
    local msg="Terminal too narrow"
    zcurses move stdscr $(( LINES / 2 )) $(( (COLUMNS - ${#msg}) / 2 ))
    zcurses string stdscr "$msg"
    zcurses refresh stdscr
    return
  fi

  # --- Render header ---
  zcurses clear header
  local header_text="$list_name"
  local header_pad=$(( (COLUMNS - ${#header_text}) / 2 ))
  zcurses attr header +bold cyan/black
  zcurses move header 0 $header_pad
  zcurses string header "$header_text"
  zcurses attr header -bold white/black

  # --- Render columns ---
  local i row_count task_line
  local cell_id cell_pri cell_tags cell_text rest
  local pri_char
  local col_h=$(( LINES - 2 ))
  local max_task_rows=$(( col_h - 3 ))  # border top + status header + border bottom

  for (( i=1; i<=num_cols; i++ )); do
    zcurses clear "col${i}"
    zcurses border "col${i}"

    # Status header (centered in column, bold cyan)
    local status_name="${_TD_UI_STATUSES[$i]}"
    local status_upper="${status_name:u}"
    local status_count="${_TD_UI_COL_COUNTS[$i]:-0}"
    local status_label="${status_upper} (${status_count})"
    local inner_width=$(( col_width - 2 ))
    local label_pad=$(( (inner_width - ${#status_label}) / 2 ))
    (( label_pad < 1 )) && label_pad=1

    zcurses attr "col${i}" +bold cyan/black
    zcurses move "col${i}" 1 $label_pad
    zcurses string "col${i}" "$status_label"
    zcurses attr "col${i}" -bold white/black

    # Render tasks
    row_count=${_TD_UI_COL_COUNTS[$i]:-0}
    local r is_selected
    for (( r=1; r<=row_count && r<=max_task_rows; r++ )); do
      task_line="${_TD_UI_COL_TASKS[$i,$r]}"
      [[ -z "$task_line" ]] && continue

      # Parse: id\tpriority\ttags\ttext\tref
      cell_id="${task_line%%	*}"
      rest="${task_line#*	}"
      cell_pri="${rest%%	*}"
      rest="${rest#*	}"
      cell_tags="${rest%%	*}"
      rest="${rest#*	}"
      cell_text="${rest%%	*}"

      # Check if this task is selected
      is_selected=0
      if (( i == _TD_UI_SEL_COL && r == _TD_UI_SEL_ROW )); then
        is_selected=1
      fi

      local task_row=$(( r + 1 ))  # row 0=border, 1=header, 2+=tasks

      if (( is_selected )); then
        # Selected task: reverse video for entire row, skip per-field colors
        zcurses attr "col${i}" reverse

        # Priority indicator (no color, just the char)
        pri_char=" "
        case "$cell_pri" in
          high)   pri_char="!" ;;
          medium) pri_char="~" ;;
          low)    pri_char="." ;;
        esac

        zcurses move "col${i}" $task_row 1

        # Build the full line and pad to inner_width
        local prefix_len=11  # "! ABCD1234 " = 1+1+8+1
        local max_text=$(( inner_width - prefix_len ))
        (( max_text < 1 )) && max_text=1
        local display_text="$cell_text"
        if (( ${#display_text} > max_text )); then
          display_text="${display_text:0:$((max_text - 1))}~"
        fi

        local full_line="${pri_char} ${cell_id:0:8} ${display_text}"
        # Pad to fill the column width for full reverse highlight
        local line_pad=$(( inner_width - ${#full_line} ))
        (( line_pad < 0 )) && line_pad=0
        zcurses string "col${i}" "${full_line}${(l:$line_pad:: :)}"

        zcurses attr "col${i}" -reverse white/black
      else
        # Non-selected task: render with per-field colors as before
        pri_char=" "
        case "$cell_pri" in
          high)
            pri_char="!"
            zcurses attr "col${i}" +bold red/black
            ;;
          medium)
            pri_char="~"
            zcurses attr "col${i}" +bold yellow/black
            ;;
          low)
            pri_char="."
            zcurses attr "col${i}" green/black
            ;;
        esac

        zcurses move "col${i}" $task_row 1
        zcurses string "col${i}" "$pri_char"
        zcurses attr "col${i}" -bold white/black

        # ID (dim)
        zcurses attr "col${i}" dim
        zcurses string "col${i}" " ${cell_id:0:8}"
        zcurses attr "col${i}" -dim white/black

        # Text (truncated to fit)
        local prefix_len=11  # "! ABCD1234 " = 1+1+8+1
        local max_text=$(( inner_width - prefix_len ))
        (( max_text < 1 )) && max_text=1
        local display_text="$cell_text"
        if (( ${#display_text} > max_text )); then
          display_text="${display_text:0:$((max_text - 1))}~"
        fi
        zcurses string "col${i}" " $display_text"
      fi
    done

    # Show overflow indicator if more tasks than visible rows
    if (( row_count > max_task_rows )); then
      local overflow_msg="... +$(( row_count - max_task_rows )) more"
      zcurses attr "col${i}" dim
      zcurses move "col${i}" $(( max_task_rows + 2 )) 1
      zcurses string "col${i}" "$overflow_msg"
      zcurses attr "col${i}" -dim white/black
    fi

    # Show (empty) if no tasks
    if (( row_count == 0 )); then
      zcurses attr "col${i}" dim
      zcurses move "col${i}" 2 1
      zcurses string "col${i}" "(empty)"
      zcurses attr "col${i}" -dim white/black
    fi
  done

  # --- Render status bar ---
  zcurses clear statusbar
  zcurses attr statusbar reverse
  local bar_text=" ${list_name} | ${_TD_UI_TOTAL_TASKS} tasks | j/k:move h/l:col s:status d:done x:del o:open ?:help q:quit "
  # Pad to full width
  local bar_pad=$(( COLUMNS - ${#bar_text} ))
  (( bar_pad < 0 )) && bar_pad=0
  zcurses move statusbar 0 0
  zcurses string statusbar "${bar_text}${(l:$bar_pad:: :)}"
  zcurses attr statusbar -reverse

  # Refresh all windows
  local -a refresh_args=(header)
  for (( i=1; i<=num_cols; i++ )); do
    refresh_args+=("col${i}")
  done
  refresh_args+=(statusbar)
  zcurses refresh "${refresh_args[@]}"
}

# Main engine entry point
_td_interactive_run() {
  # TTY gate (Pitfall 8)
  [[ -t 0 ]] && [[ -t 1 ]] || {
    _td_error "Interactive mode requires a terminal"
    return 1
  }

  # Terminal size check
  if (( LINES < 10 || COLUMNS < 40 )); then
    _td_error "Terminal too small (min 40x10)"
    return 1
  fi

  # Load data
  _td_storage_init || return 1
  local tasks_file
  tasks_file="$(_td_storage_list_path)" || return 1
  _TD_UI_LIST_NAME="$(_td_storage_active_list)"

  _TD_UI_TASKS_FILE="$tasks_file"
  _td_interactive_load_data "$tasks_file" || return 1
  _td_interactive_init_selection

  # zcurses lifecycle
  zmodload zsh/curses || {
    _td_error "zcurses module not available"
    return 1
  }

  {
    zcurses init
    echoti civis  # hide cursor
    zcurses clear stdscr redraw
    zcurses refresh stdscr

    # Create windows
    _td_interactive_create_windows

    # TRAPWINCH: set redraw flag on terminal resize (function form for zcurses compat)
    TRAPWINCH() {
      _TD_UI_NEED_REDRAW=1
    }

    # Initial render
    _td_interactive_render "$_TD_UI_LIST_NAME"

    # Input loop
    local key kkey
    zcurses timeout stdscr 200  # 200ms polling for resize detection

    while true; do
      if zcurses input stdscr key kkey; then
        # Dismiss help overlay on any key (except ? which toggles)
        if (( _TD_UI_HELP_VISIBLE )) && [[ "$key$kkey" != '?' ]]; then
          _td_interactive_hide_help
          continue
        fi

        case $key$kkey in
          q) break ;;
          j|DOWN)  _td_interactive_nav_down; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          k|UP)    _td_interactive_nav_up; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          l|RIGHT) _td_interactive_nav_right; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          h|LEFT)  _td_interactive_nav_left; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          s) _td_interactive_action_status; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          d) _td_interactive_action_done; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          x) _td_interactive_action_delete; _td_interactive_render "$_TD_UI_LIST_NAME" ;;
          o) _td_interactive_action_open ;;
          '?')
            if (( _TD_UI_HELP_VISIBLE )); then
              _td_interactive_hide_help
            else
              _td_interactive_show_help
            fi
            ;;
        esac
      fi
      # Timeout branch: check resize flag
      if (( _TD_UI_NEED_REDRAW )); then
        _td_interactive_handle_resize
      fi
    done
  } always {
    # Remove TRAPWINCH to avoid leaking the handler
    unfunction TRAPWINCH 2>/dev/null
    # Cleanup all windows
    _td_interactive_cleanup_windows
    echoti cnorm  # show cursor
    zcurses end   # restore terminal
  }
}
