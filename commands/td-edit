# td-edit - edit task title
# Autoloaded: file body = function body

local id_prefix="$1"
shift 2>/dev/null
local new_text="$*"

[[ -z "$id_prefix" ]] && {
  _td_error "Usage: todo edit <task-id> <new title>"
  return 1
}

[[ -z "$new_text" ]] && {
  _td_error "New title required"
  return 1
}

_td_storage_init

local tasks_file
tasks_file="$(_td_storage_list_path)"

local task_id
task_id="$(_td_resolve_task_id "$tasks_file" "$id_prefix")" || return 1

export TASK_ID="$task_id"
export NEW_TEXT="$new_text"
_td_storage_modify "$tasks_file" '
  var env = $.NSProcessInfo.processInfo.environment;
  var tid = env.objectForKey("TASK_ID").js;
  var txt = env.objectForKey("NEW_TEXT").js;
  var idx = data.tasks.findIndex(function(t) { return t.id === tid; });
  if (idx === -1) throw new Error("not found");
  data.tasks[idx].text = txt;
  data.tasks[idx].updated = new Date().toISOString();
'
local rc=$?
unset TASK_ID NEW_TEXT

(( rc == 0 )) && _td_success "Updated task ${task_id:0:8}"
return $rc
