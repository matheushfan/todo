# td-add - create a new task
# Autoloaded: file body = function body

local -a priority_opt tags_opt ref_opt
zparseopts -D -E - p:=priority_opt -priority:=priority_opt t+:=tags_opt -tags+:=tags_opt r:=ref_opt -ref:=ref_opt

local text="$*"

local task_ref="${ref_opt[2]:-}"

[[ -z "$text" ]] && {
  _td_error "Usage: todo add [-p high|medium|low] [-t tag ...] [-r url] <title>"
  return 1
}

local task_priority="medium"
if (( ${#priority_opt} > 0 )); then
  task_priority="${priority_opt[2]}"
  case "$task_priority" in
    high|medium|low) ;;
    *)
      _td_error "Invalid priority '$task_priority'. Use: high, medium, low"
      return 1
      ;;
  esac
fi

# Accept both documented spellings: repeated flags (-t a -t b) and the
# comma-separated form the README uses (-t a,b). The comma form used to be
# rejected outright by the per-tag validator.
local -a tags=()
local i t one
for (( i=1; i<=${#tags_opt}; i+=2 )); do
  t="${tags_opt[$((i+1))]}"
  for one in ${(s:,:)t}; do
    [[ -z "$one" ]] && continue
    if [[ ! "$one" =~ ^[a-zA-Z0-9_-]+$ ]]; then
      _td_error "Invalid tag '$one'. Use letters, numbers, hyphens, underscores only."
      return 1
    fi
    tags+=("$one")
  done
done
# Deduplicate so -t a,a and -t a -t a both yield one tag.
tags=("${(@u)tags}")

_td_storage_init

local tasks_file
tasks_file="$(_td_storage_list_path)"

export TASK_TAGS="${(j:,:)tags}"
export TASK_REF="$task_ref"

local task_id
task_id="$(_td_storage_add_task "$tasks_file" "$text" "todo" "$task_priority")" || {
  unset TASK_TAGS TASK_REF
  return 1
}
unset TASK_TAGS TASK_REF

_td_success "Created task ${task_id:0:8}"
