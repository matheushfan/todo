#!/usr/bin/env zsh
# todo - CLI task manager

# Capture script path before entering function ($0 becomes function name inside main)
typeset -g _TD_SCRIPT_DIR="${0:A:h}"

main() {
  local td_root="$_TD_SCRIPT_DIR/.."

  # Globals (intentional, used by all commands)
  typeset -g TD_ROOT="$td_root"
  typeset -g TD_VERSION="0.3.0"
  typeset -g TD_DATA="${TODOLIST_DATA:-$HOME/.todolist}"

  # Set function search path (project dirs first)
  fpath=("$TD_ROOT/lib" "$TD_ROOT/commands" $fpath)

  # Load core utilities (needed by all paths)
  autoload -Uz _td_core && _td_core

  # Load storage locking (must precede the storage engine)
  autoload -Uz _td_lock && _td_lock

  # Load storage engine (JSON data layer)
  autoload -Uz _td_storage && _td_storage

  # Load rendering primitives (measurement, theme, glyphs) then the legacy
  # color map, which now derives from them
  autoload -Uz _td_ui && _td_ui
  _td_ui_init

  # Load color rendering library
  autoload -Uz _td_color && _td_color

  # Load kanban board rendering engine
  autoload -Uz _td_board && _td_board

  # Load interactive zcurses engine
  autoload -Uz _td_interactive && _td_interactive

  # Dispatch
  local cmd="${1:-board}"
  shift 2>/dev/null

  local func="td-${cmd}"
  if autoload -Uz +X "$func" 2>/dev/null; then
    "$func" "$@"
  else
    _td_error "'$cmd' is not a command. See 'todo help'."
    return 1
  fi
}

# Lock safety net. These must stay at the top level: in zsh a trap installed
# inside a function is local to that function and fires the moment it returns,
# which would drop every lock immediately and protect nothing.
trap '_td_lock_release_all 2>/dev/null' EXIT
trap '_td_lock_release_all 2>/dev/null; exit 130' INT
trap '_td_lock_release_all 2>/dev/null; exit 143' TERM
trap '_td_lock_release_all 2>/dev/null; exit 129' HUP

main "$@"
